# Pooled connection used by the running Next.js application.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tindahan

# Unpooled connection used by normal Prisma migration commands.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/tindahan

# Isolated database used by test migrations and future integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tindahan_test
TEST_DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tindahan_test

NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_URL=http://localhost:3000

# Development-only authenticated walkthrough. Production rejects this mode.
AUTH_DEMO_MODE=false
DEMO_EMAIL=rosa@tindahan.local
DEMO_PASSWORD=tindahan123

# Phase 7 SaaS policy. Billing remains behind a provider-neutral server adapter;
# `manual` is the approved pilot operator target and does not simulate checkout.
BILLING_PROVIDER=manual
TRIAL_DAYS=30
BILLING_GRACE_DAYS=7
STAFF_INVITE_TTL_DAYS=7

# Shared abuse protection. Production requires `database` so limits remain
# effective across multiple application instances. `memory` is test-only.
RATE_LIMIT_PROVIDER=database

# Receipt files stay private. Use `local` only for explicit development;
# production uses an existing private AWS S3 bucket. A blank endpoint enables
# standard AWS regional endpoint resolution.
# In AWS Lambda, omit both S3 credential variables so the SDK uses the
# function execution role. Outside Lambda, configure the complete key pair.
RECEIPT_STORAGE_PROVIDER=local
RECEIPT_STORAGE_DIR=receipts
RECEIPT_S3_ENDPOINT=
RECEIPT_S3_REGION=ap-southeast-1
RECEIPT_S3_BUCKET=tindahan-receipts
RECEIPT_S3_ACCESS_KEY_ID=
RECEIPT_S3_SECRET_ACCESS_KEY=
RECEIPT_S3_FORCE_PATH_STYLE=false
RECEIPT_UPLOAD_TTL_SECONDS=600
RECEIPT_READ_TTL_SECONDS=300

# Durable jobs are always persisted in PostgreSQL. The optional webhook wakes
# an external worker; local development runs `pnpm receipts:worker`.
RECEIPT_JOB_PROVIDER=database
RECEIPT_JOB_WAKE_URL=
RECEIPT_JOB_SECRET=

# Deterministic mock extraction is safe for explicit development and tests.
# Production uses the existing Azure AI Document Intelligence resource.
RECEIPT_OCR_PROVIDER=mock
RECEIPT_OCR_ENDPOINT=
RECEIPT_OCR_API_KEY=
RECEIPT_OCR_API_VERSION=2024-11-30
