# Pooled connection used by the running Next.js application.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tindahan

# Unpooled connection used by normal Prisma migration commands.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:5432/tindahan

# Isolated database used by test migrations and future integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tindahan_test
TEST_DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/tindahan_test

NEXTAUTH_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_URL=http://localhost:3000

# Development-only authenticated walkthrough. Production rejects this mode.
AUTH_DEMO_MODE=false
DEMO_EMAIL=rosa@tindahan.local
DEMO_PASSWORD=tindahan123

# Employer showcase branch only. Never enable this on the real app project.
# The showcase still uses a real isolated database/account, but permits safe
# mock/local adapters instead of paid production integrations.
SHOWCASE_MODE=false

# Public application origin used only to construct return and invitation links.
APP_URL=http://localhost:3000

# Production billing uses the existing Xendit account in test or live mode.
# BILLING_STANDARD_MONTHLY_AMOUNT_PHP is a whole-peso amount, not centavos:
# use 499 for a PHP 499.00 monthly Standard plan. Keep credentials out of git.
# `manual` remains available for pilot operations and the isolated showcase.
BILLING_PROVIDER=manual
BILLING_STANDARD_MONTHLY_AMOUNT_PHP=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
BILLING_TAX_ENABLED=false
BILLING_TAX_RATE_BPS=0
BILLING_TAX_LABEL=Tax
TRIAL_DAYS=30
BILLING_GRACE_DAYS=7
STAFF_INVITE_TTL_DAYS=7

# Transactional and operational email. A Resend sender must belong to a verified domain.
# Keep `mock` in the public employer showcase so visitors cannot send real mail.
EMAIL_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Tindahan

# Vercel Cron sends this value as `Authorization: Bearer <CRON_SECRET>`.
# Generate a long random value in production. The daily store summary runs once
# per day at 11:00 UTC (around 7:00 PM Asia/Manila).
CRON_SECRET=

# Shared abuse protection. Production requires `database` so limits remain
# effective across multiple application instances.
RATE_LIMIT_PROVIDER=database

# Receipt files stay private. Use `local` only for explicit development or the
# isolated employer showcase; the real production app uses private AWS S3.
# In AWS Lambda, omit both S3 credential variables so the SDK uses the
# function execution role. Outside Lambda, configure the complete key pair.
RECEIPT_STORAGE_PROVIDER=local
RECEIPT_STORAGE_DIR=receipts
RECEIPT_S3_ENDPOINT=
RECEIPT_S3_REGION=ap-southeast-1
RECEIPT_S3_BUCKET=tindahan-receipts
RECEIPT_S3_ACCESS_KEY_ID=
RECEIPT_S3_SECRET_ACCESS_KEY=
RECEIPT_S3_FORCE_PATH_STYLE=false
RECEIPT_UPLOAD_TTL_SECONDS=600
RECEIPT_READ_TTL_SECONDS=300

# Durable jobs are always persisted in PostgreSQL. The optional webhook wakes
# an external worker; local development runs `pnpm receipts:worker`.
RECEIPT_JOB_PROVIDER=database
RECEIPT_JOB_WAKE_URL=
RECEIPT_JOB_SECRET=

# Deterministic mock extraction is safe for explicit development, tests, and
# the isolated showcase. The real production app uses Azure AI Document Intelligence.
RECEIPT_OCR_PROVIDER=mock
RECEIPT_OCR_ENDPOINT=
RECEIPT_OCR_API_KEY=
RECEIPT_OCR_API_VERSION=2024-11-30
